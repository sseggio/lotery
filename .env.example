# Copy to .env and adjust. Never commit .env.

# Protect the whole site with HTTP Basic auth (strongly recommended on a public VPS).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# First year downloaded on the initial sync (backtest + popularity model need history).
HISTORY_START_YEAR=2016

# Minimum delay (seconds) between two manual "Actualiser les tirages".
SYNC_MIN_INTERVAL_S=60

# Your public domain(s), comma-separated: rejects requests with another Host header.
ALLOWED_HOSTS=

# IP of your reverse proxy as seen by the container (trusted for X-Forwarded-For).
# With docker compose + a proxy on the host, this is usually the Docker gateway, e.g. 172.17.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Max POST requests per client IP per minute.
POST_RATE_PER_MIN=40

# ---- Traefik deployment (docker-compose.traefik.yml) ----
# Public domain of the site (DNS A/AAAA record pointing to the VPS).
DOMAIN=
# External Docker network shared with Traefik (see: docker network ls).
TRAEFIK_NETWORK=
# Name of the HTTPS entrypoint and certificate resolver in your Traefik config.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Subnet of TRAEFIK_NETWORK, e.g. 172.18.0.0/16
# (docker network inspect <net> --format '{{(index .IPAM.Config 0).Subnet}}')
TRAEFIK_SUBNET=
